{
  "name": "dsh-model-fix",
  "version": "0.33.0",
  "author": "Tika Flow / 兮夏",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.7-rc.2"
  },
  "description": "DSH 插件：提供更好的模型使用体验，包括但不限于：多种方式填充模型参数、提升模型兼容性、记住推理级别、子智能体实时跟随模型和推理级别、AI 自主调节档位等。",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsdown --config tsdown.test.config.ts && node .test-dist/index.mjs",
    "pack:release": "pnpm pack --out=\"dist/%s.tgz\"",
    "hook:git": "nit install && nit check",
    "prepare": "pnpm build"
  },
  "devDependencies": {
